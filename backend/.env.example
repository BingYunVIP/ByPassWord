# ===== 应用 =====
APP_NAME=ByPassWord
APP_ENV=development
APP_VERSION=0.1.0

# ===== 数据库 =====
# 生产：sqlite+aiosqlite:////var/lib/bypw/vault.db （四个斜杠 = 绝对路径）
DATABASE_URL=sqlite+aiosqlite:///./bypw.db
# 启动时自动执行 alembic 迁移（本地开发建议 true；生产建议 false，由部署脚本显式迁移）
AUTO_MIGRATE=true
# 限流开关（本地冒烟可设 false）
RATE_LIMIT_ENABLED=true
# 默认个人实例只允许首次创建账号；已有其他账号仍可登录
ALLOW_REGISTRATION_AFTER_FIRST=false

# ===== 密钥（务必替换，且两者必须不同）=====
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-jwt-secret-change-me
SERVER_SECRET=dev-insecure-server-secret-change-me
# local/production 必须使用上面两个不同的随机秘密，开发默认值会拒绝启动。

# ===== 本地部署（APP_ENV=local 时）=====
# 独立32字节随机二进制key文件，0600，与备份文件分开放；不要填入源码/备份包。
BACKUP_KEY_FILE=
BACKUP_DIR=./backups
BACKUP_TIMEZONE=Asia/Singapore
# 指向已构建frontend/dist；留空不提供SPA静态服务
STATIC_DIR=
MAX_REQUEST_BYTES=4194304
REQUEST_BODY_TIMEOUT_SECONDS=15
# local固有限制localhost/127.0.0.1/::1；production可显式列出域名
ALLOWED_HOSTS=
# 只信任明确列出的反向代理IP；本机部署直接访问保持空值
TRUSTED_PROXY_IPS=

# ===== 令牌 =====
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ===== CORS（逗号分隔）=====
ALLOWED_ORIGINS=http://localhost:899,http://127.0.0.1:899

# ===== QQ 邮箱 SMTP（也可在设置页覆盖）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ByPassWord
